datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id             String          @id @default(uuid())
  username       String          @unique
  password       String
  portfolioItems PortfolioItem[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model PortfolioItem {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  title       String
  description String?
  extractedData String // Store structured JSON data as string or use Json type if switched to PG
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
